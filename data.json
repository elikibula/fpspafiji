  "model": "news.news",
  "pk": 1,
  "fields": {
    "title": "TEST 1",
    "slug": "test-1",
    "content": "A senior Fiji Corrections Service officer has been charged and will be appear in the Suva Magistrates Court today.\r\n\r\nPolice say following consultations with the Office of the Director of Public Prosecutions, the senior executive has been charged with one count of criminal intimidation.\r\n\r\nIt is alleged that in July this year, he threatened a member of his support staff.\r\n\r\nA complaint was lodged by the victim earlier at CID headquarters.",
    "author": [
      "lixtronics"
    ],
    "image": "news_images/OGEA_HOUSE.png",
    "video": "",
    "category": 1,
    "date_posted": "2025-10-06T22:53:47.166Z",
    "is_featured": true
  }
},
